---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../posts';
const posts = await getPosts();
---
<Base title="Dev log" description="What changed in each build of Dig & Dominate, in plain language.">
  <section>
    <div class="wrap">
      <h2>Dev log</h2>
      <p class="sub">What changed in each build, written for players. Newest first. Follow along with the <a href="/devlog/rss.xml">RSS feed</a>.</p>
      <ul class="post-list">
        {posts.map((p) => (
          <li><a href={`/devlog/${p.id}/`}><div class="card post-card">
            {p.data.image && <img class="thumb" src={p.data.image} alt="" loading="lazy" decoding="async" />}
            <div>
            <div class="kicker">Dig Log #{p.data.number}</div>
            <h3>{p.data.title}{p.data.build && <span class="tag">{p.data.build}</span>}</h3>
            <div class="meta">{formatDate(p.data.date)}</div>
            <p>{p.data.summary}</p>
            </div>
          </div></a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
