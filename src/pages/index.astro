---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
---
<Base title="Coming soon">
  <main class="hero soon">
    <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="/video/hero-poster.webp" aria-hidden="true">
      <source src="/video/hero-loop.webm" type="video/webm" />
      <source src="/video/hero-loop.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade"></div>
    <div class="wrap">
      <img class="soon-mark" src="/favicon.svg" alt="" width="64" height="64" />
      <h1>Dig <span class="amp">&amp;</span> Dominate</h1>
      <p class="lead">{SITE.tagline}</p>
      <p class="soon-badge">Coming soon</p>
    </div>
  </main>
</Base>
