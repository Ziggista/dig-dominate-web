<dialog id="lightbox" aria-label="Enlarged image">
  <button class="lb-close" type="button" aria-label="Close">&times;</button>
  <img alt="" />
  <p class="lb-caption"></p>
</dialog>
<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dlg && typeof dlg.showModal === 'function') {
    const img = dlg.querySelector('img') as HTMLImageElement;
    const cap = dlg.querySelector('.lb-caption') as HTMLElement;
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a[data-lightbox]') as HTMLAnchorElement | null;
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      const inner = a.querySelector('img');
      img.src = a.href;
      img.alt = inner?.alt ?? '';
      cap.textContent = a.dataset.caption ?? '';
      dlg.showModal();
    });
    dlg.addEventListener('click', () => dlg.close());
  }
</script>
